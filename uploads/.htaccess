# Security for uploads: never execute scripts from here
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .phps
RemoveType .php .phtml .php3 .php4 .php5 .php7 .phps
php_flag engine off
Options -ExecCGI
<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|pl|py|cgi)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
