# =============================
# BASIC .htaccess (Safe Version)
# =============================

AddType image/webp .webp

<IfModule mod_headers.c>
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: https://cdn.tiny.cloud https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; \
    style-src   'self' 'unsafe-inline' https://cdn.tiny.cloud https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; \
    img-src     'self' data: blob: https:; \
    font-src    'self' https://cdn.tiny.cloud https://cdnjs.cloudflare.com https://pay.pesapal.com; \
    connect-src 'self' https: https://pay.pesapal.com https://www.pesapal.com https://centinelapi.cardinalcommerce.com https://writer.cardinalcommerce.com; \
    frame-src   'self' https://www.youtube.com https://player.vimeo.com https://drive.google.com https://pay.pesapal.com; \
    base-uri 'self'; \
    form-action 'self'; \
    upgrade-insecure-requests; \
    block-all-mixed-content"
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Skip HTTPS/host rewrites on localhost
  RewriteCond %{HTTP_HOST} ^localhost$ [NC]
  RewriteRule ^ - [S=2]

  # --- STEP 1: Force HTTPS (only if not already secure)
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- STEP 2: Canonical Host (Force www)
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # --- STEP 3: Exclude google_callback.php
  RewriteRule ^google_callback\.php$ - [L]

  # --- STEP 4: Skip existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Missing static assets should not be routed to PHP; return 404 instead
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} \.(?:png|jpe?g|webp|gif|svg|ico|css|js|mp3|mp4|wav|woff2|woff|ttf)$ [NC]
  RewriteRule ^ - [R=404,L]

  # --- STEP 5: Route everything else to index.php
  RewriteRule ^ index.php [L]
</IfModule>
